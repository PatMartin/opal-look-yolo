# OPAL dotenv example.
# Startup reads ./.env by default; real environment variables always win,
# including empty strings. Use --env-file PATH for another file, or
# --no-env-file to disable loading and initialization. Secret values stay
# local; this example is safe to commit.

# OPAL_YOLO_HOST
#OPAL_YOLO_HOST=127.0.0.1

# OPAL_YOLO_PORT
#OPAL_YOLO_PORT=8086

# OPAL_YOLO_AUTH_DISABLED
#OPAL_YOLO_AUTH_DISABLED=true

# OPAL_YOLO_MODEL_DIRS
#OPAL_YOLO_MODEL_DIRS=models

# OPAL_YOLO_MAX_IMAGE_BYTES
#OPAL_YOLO_MAX_IMAGE_BYTES=10485760

# OPAL_YOLO_MAX_CONCURRENT_PREDICTIONS
#OPAL_YOLO_MAX_CONCURRENT_PREDICTIONS=2

# OPAL_YOLO_ALLOW_REMOTE_SOURCES
#OPAL_YOLO_ALLOW_REMOTE_SOURCES=false

# OPAL_YOLO_ALLOWED_REMOTE_HOSTS
#OPAL_YOLO_ALLOWED_REMOTE_HOSTS=

# OPAL_YOLO_REMOTE_SOURCE_TIMEOUT_SECONDS
#OPAL_YOLO_REMOTE_SOURCE_TIMEOUT_SECONDS=5.0

# OPAL_YOLO_AUTH_TOKEN
#OPAL_YOLO_AUTH_TOKEN=<optional-bearer-token>

# OPAL_YOLO_URL
#OPAL_YOLO_URL=<remote-url-when-not-embedded>

# OPAL_YOLO_TOKEN
#OPAL_YOLO_TOKEN=<remote-bearer-token>

